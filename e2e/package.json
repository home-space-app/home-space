{
  "name": "home-space-e2e",
  "private": true,
  "type": "module",
  "description": "End-to-end tests: a throwaway Postgres, the real server and web build, and real clients.",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web",
    "test:android": "playwright test --project=android",
    "report": "playwright show-report",
    "build:android": "cd ../clients/mobile && ./gradlew :androidApp:assembleDebug",
    "appium:drivers": "APPIUM_HOME=.appium appium driver install uiautomator2@9.2.1",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "appium": "4.0.0",
    "get-port": "7.2.0",
    "pg": "8.23.1",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "webdriverio": "10.2.0"
  }
}
